server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Meter photos get POSTed through the n8n webhook, so allow decent uploads.
    client_max_body_size 25m;

    # Docker's embedded DNS. Combined with the variable proxy_pass below, this
    # resolves upstreams per-request instead of only at nginx startup, so the
    # backend containers can restart without taking this one down with them.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # --- internal API routes -------------------------------------------------
    # These live INSIDE the app's own prefix (APP_BASE_PATH, no trailing slash).
    # That is deliberate: the reverse proxy in front only ever needs ONE custom
    # location per app, so shipping another app never means touching its routes.
    #
    # `rewrite ... break` strips the prefix, which a variable-based proxy_pass
    # cannot do on its own.

    location ${APP_BASE_PATH}/api/n8n/ {
        # N8N_UPSTREAM is injected by the nginx image's envsubst step, which
        # turns /etc/nginx/templates/*.template into /etc/nginx/conf.d/*.conf
        # at container start. Set it to `<host>:<port>` of an n8n reachable from
        # this container, which is usually NOT a container name here: the shared
        # n8n tends to live on its own docker network where this project's
        # container names do not resolve.
        set $n8n_upstream ${N8N_UPSTREAM};
        rewrite ^${APP_BASE_PATH}/api/n8n/(.*)$ /$1 break;
        proxy_pass http://$n8n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # The reader may hand the photo to a model; give it room to answer.
        proxy_read_timeout 300s;
    }

    location ${APP_BASE_PATH}/api/meter/ {
        set $meter_upstream tnbcheck_local_api:3001;
        rewrite ^${APP_BASE_PATH}/api/meter/(.*)$ /$1 break;
        proxy_pass http://$meter_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- static SPA ----------------------------------------------------------
    # Build output is mounted at /usr/share/nginx/html${APP_BASE_PATH}, so
    # requests pass through untouched and the bundler's asset URLs (which carry
    # the same base path) resolve directly - no alias needed.
    location ${APP_BASE_PATH}/ {
        try_files $uri $uri/ ${APP_BASE_PATH}/index.html;
    }

    location = ${APP_BASE_PATH} {
        return 301 ${APP_BASE_PATH}/;
    }

    # Everything else belongs to other apps behind the reverse proxy.
    location / {
        return 404;
    }
}
