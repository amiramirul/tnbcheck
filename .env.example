POSTGRES_DB=tnbcheck
POSTGRES_USER=tnbcheck
POSTGRES_PASSWORD=change-this-local-password

# Tukar kepada secret rawak yang stabil jika mahu kekalkan credential n8n.
N8N_ENCRYPTION_KEY=change-this-to-a-long-random-local-key

# Google AI Studio key is used only by the server-side local-api container.
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Aiven database for bill records only. Leave blank to use local Postgres.
BILL_DB_HOST=
BILL_DB_PORT=5432
BILL_DB_NAME=
BILL_DB_USER=
BILL_DB_PASSWORD=
BILL_DB_SSL_CA_FILE=
