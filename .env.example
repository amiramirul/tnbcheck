# Copy to .env and fill in. .env is gitignored - never commit it.
# Every value here is deployment-specific.

# --- app publishing ---------------------------------------------------------
# Subpath the app is served under, no trailing slash. Must match the reverse
# proxy's location block for this app.
APP_BASE_PATH=/tnbcheck

# Host ports this stack publishes. Pick free ones; check with `ss -tln`.
APP_PORT=5180
LOCAL_API_PORT=5181

# --- n8n --------------------------------------------------------------------
# Hostname or `<host>:<port>` of the n8n that handles the webhook. Defaults to
# `n8n:5678`, which is correct when an n8n compose service shares the `edge`
# network. Only set this if your n8n is somewhere else.
N8N_UPSTREAM=

# The reverse direction needs no configuration here: the imported workflows call
# this stack's local-api as http://tnbcheck_local_api:3001, so n8n only has to
# share the `edge` network. Give it that network in its own compose file:
#   networks: [default, edge]   # edge declared external
# Names are used rather than host addresses on purpose: cross-network container
# names keep the repo free of deployment addresses, and docker's embedded DNS
# re-resolves them per request, so a restarted container is picked up without
# any stale-IP failures.
#
# Note n8n 2.x blocks {{ $env.* }} by default
# (N8N_BLOCK_ENV_ACCESS_IN_NODE=true). Do NOT turn that off to pass one URL
# around: it re-opens every environment variable, including DB passwords, to any
# workflow author.

# --- database ---------------------------------------------------------------
POSTGRES_DB=tnbcheck
POSTGRES_USER=tnbcheck
POSTGRES_PASSWORD=change-this-local-password

# Optional external Postgres for bill records. Leave host blank to use the
# bundled local Postgres instead.
BILL_DB_HOST=
BILL_DB_PORT=5432
BILL_DB_NAME=
BILL_DB_USER=
BILL_DB_PASSWORD=
# CA certificate path inside the local-api container, e.g. /certs/ca.pem
BILL_DB_SSL_CA_FILE=

# --- model ------------------------------------------------------------------
# Used only by the server-side local-api container. Never expose it to the
# browser: this stack serves static files, so it stays server-side.
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
