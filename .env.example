# Copy to .env and fill in. .env is gitignored - never commit it.
# Every value here is deployment-specific.

# --- app publishing ---------------------------------------------------------
# Subpath the app is served under, no trailing slash. Must match the reverse
# proxy's location block for this app.
APP_BASE_PATH=/tnbcheck

# Host ports this stack publishes. Pick free ones; check with `ss -tln`.
APP_PORT=5180
LOCAL_API_PORT=5181

# --- n8n --------------------------------------------------------------------
# `<host>:<port>` of an n8n instance reachable from the app container. This is
# used for the webhook route, so it must be an address that n8n itself listens
# on. If your n8n runs in its own docker network, a container name will NOT
# resolve here - use a host address instead.
N8N_UPSTREAM=your-n8n-host:5678

# The flip side: your n8n needs to reach this stack's local-api. Set this as an
# environment variable ON THE N8N CONTAINER (not here). The imported workflows
# read it as {{ $env.TNBCHECK_API_BASE }}.
#   TNBCHECK_API_BASE=http://your-docker-host:5181

# --- database ---------------------------------------------------------------
POSTGRES_DB=tnbcheck
POSTGRES_USER=tnbcheck
POSTGRES_PASSWORD=change-this-local-password

# Optional external Postgres for bill records. Leave host blank to use the
# bundled local Postgres instead.
BILL_DB_HOST=
BILL_DB_PORT=5432
BILL_DB_NAME=
BILL_DB_USER=
BILL_DB_PASSWORD=
# CA certificate path inside the local-api container, e.g. /certs/ca.pem
BILL_DB_SSL_CA_FILE=

# --- model ------------------------------------------------------------------
# Used only by the server-side local-api container. Never expose it to the
# browser: this stack serves static files, so it stays server-side.
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
