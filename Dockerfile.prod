# Production image: pre-built static assets served by nginx.
#
# The repo's default Dockerfile runs the Vite dev server, which is not meant to
# face the internet. This one does `npm run build` and serves the output.
#
# APP_BASE_PATH is the subpath the app is published under (e.g. /tnbcheck for
# https://apps.example.com/tnbcheck). It is baked into the bundle at build time
# AND used as the mount point in the runtime stage, so the two can never drift:
# without it the browser requests assets from the domain root and gets 404.
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG APP_BASE_PATH=/tnbcheck
ENV VITE_BASE_PATH=${APP_BASE_PATH}/
RUN npm run build


FROM nginx:1.27-alpine

# The nginx image renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/ at container start, substituting the environment variables
# it finds. It only substitutes names present in the environment, so nginx's own
# $uri/$host-style variables in the template are left alone.
ARG APP_BASE_PATH=/tnbcheck
ENV APP_BASE_PATH=${APP_BASE_PATH}

COPY --from=build /app/dist /usr/share/nginx/html${APP_BASE_PATH}
COPY docker/default.conf.template /etc/nginx/templates/default.conf.template

# Supplied at runtime from .env; no default on purpose.
ENV N8N_UPSTREAM=

EXPOSE 80
