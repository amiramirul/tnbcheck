# Production image: pre-built static assets served by nginx.
#
# The repo's default Dockerfile runs the Vite *dev* server, which is not meant
# to face the internet. This one does `npm run build` and serves dist/ instead.
#
# NOTE: VITE_BASE_PATH and the destination directory must stay in sync. The
# assets are mounted under /tnbcheck/ so that Vite's base='/tnbcheck/' URLs
# resolve without any nginx alias/rewrite tricks.
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_BASE_PATH=/tnbcheck/
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html/tnbcheck
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
